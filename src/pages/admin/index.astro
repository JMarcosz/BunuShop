  <!-- Animated Toast Notification -->
  <div class="hidden fixed bottom-6 right-6 z-50 bg-inverse-surface text-inverse-on-surface px-5 py-4 rounded-xl shadow-2xl flex items-center gap-4 transition-all transform translate-y-4" id="toast">
    <div class="w-9 h-9 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0">
      <span class="material-symbols-outlined text-[20px]">check</span>
    </div>
    <div class="flex flex-col">
      <span class="text-sm font-bold text-white" id="toast-title">¡Contenido Guardado!</span>
      <span class="text-xs text-pink-200" id="toast-msg">El catálogo de Accesorios Bunu Shop ha sido actualizado en vivo.</span>
    </div>
  </div>

  <!-- Client-side Management Script -->
  <script is:inline>
    // State management
    let state = JSON.parse(document.getElementById('initial-data').textContent);
    let activeTab = 'projects';

    document.addEventListener('DOMContentLoaded', () => {
      renderProjectsTable();
      renderServices();
      renderBlogPosts();
      setupEventListeners();
    });

    function setupEventListeners() {
      // Create menu dropdown toggle
      const createBtn = document.getElementById('create-btn');
      const createDropdown = document.getElementById('create-dropdown');
      if (createBtn && createDropdown) {
        createBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          createDropdown.classList.toggle('hidden');
        });
        document.addEventListener('click', () => createDropdown.classList.add('hidden'));
      }

      // Tab switching in CMS Center
      const contentTabs = document.querySelectorAll('.content-tab');
      contentTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-content-tab');
          switchContentTab(target);
        });
      });

      // Left nav rail switching
      const navItems = document.querySelectorAll('.nav-item');
      navItems.forEach(item => {
        item.addEventListener('click', () => {
          navItems.forEach(i => {
            i.classList.remove('bg-primary-container', 'text-on-primary-container');
            i.classList.add('text-secondary-fixed-dim');
          });
          item.classList.add('bg-primary-container', 'text-on-primary-container');
          item.classList.remove('text-secondary-fixed-dim');

          const navTarget = item.getAttribute('data-nav');
          if (navTarget === 'general' || navTarget === 'proyectos') switchContentTab('projects');
          else if (navTarget === 'servicios') switchContentTab('services');
          else if (navTarget === 'blog') switchContentTab('blog');
          else if (navTarget === 'config') switchContentTab('config');
        });
      });

      // Search & Filters on projects table
      const searchInput = document.getElementById('table-search');
      const filterCat = document.getElementById('table-filter-cat');
      const filterStatus = document.getElementById('table-filter-status');
      if (searchInput) searchInput.addEventListener('input', renderProjectsTable);
      if (filterCat) filterCat.addEventListener('change', renderProjectsTable);
      if (filterStatus) filterStatus.addEventListener('change', renderProjectsTable);

      // Top bar sync button
      const topSyncBtn = document.getElementById('top-sync-btn');
      if (topSyncBtn) {
        topSyncBtn.addEventListener('click', async () => {
          await persistDataToBlob();
        });
      }

      // Title slug auto generation
      const formTitle = document.getElementById('form-title');
      const slugPreview = document.getElementById('slug-preview');
      if (formTitle && slugPreview) {
        formTitle.addEventListener('input', (e) => {
          const slug = e.target.value
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
          slugPreview.textContent = slug || 'nuevo-accesorio';
        });
      }

      // Image upload drag and drop
      setupImageUpload();
    }

    function switchContentTab(tabName) {
      activeTab = tabName;
      document.querySelectorAll('.content-tab').forEach(t => {
        const isMatch = t.getAttribute('data-content-tab') === tabName;
        if (isMatch) {
          t.className = 'content-tab px-4 py-2.5 rounded-t-lg bg-surface-container-lowest text-primary-container font-semibold text-xs flex items-center gap-2 border-t-2 border-primary-container shadow-sm';
        } else {
          t.className = 'content-tab px-4 py-2.5 rounded-t-lg text-secondary hover:text-on-surface hover:bg-surface-container-lowest/50 font-medium text-xs flex items-center gap-2 transition-all';
        }
      });

      document.querySelectorAll('.tab-view').forEach(view => view.classList.add('hidden'));
      const targetView = document.getElementById(`tab-view-${tabName}`);
      if (targetView) targetView.classList.remove('hidden');
    }

    // Render Projects Table
    function renderProjectsTable() {
      const tbody = document.getElementById('projects-table-body');
      if (!tbody) return;

      const searchTerm = (document.getElementById('table-search')?.value || '').toLowerCase();
      const catFilter = document.getElementById('table-filter-cat')?.value || 'all';
      const statusFilter = document.getElementById('table-filter-status')?.value || 'all';

      const filtered = state.projects.filter(p => {
        const matchSearch = !searchTerm || p.title.toLowerCase().includes(searchTerm) || (p.description || '').toLowerCase().includes(searchTerm);
        const matchCat = catFilter === 'all' || p.category === catFilter;
        const matchStatus = statusFilter === 'all' || p.status === statusFilter;
        return matchSearch && matchCat && matchStatus;
      });

      tbody.innerHTML = filtered.map(p => `
        <tr class="hover:bg-surface-container-low/50 transition-colors group">
          <td class="py-3 px-5">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container relative shadow-sm">
                <img class="w-full h-full object-cover" src="${p.image || '/images/bunu/logo.jpg'}"/>
              </div>
              <div class="flex flex-col min-w-0">
                <span class="font-semibold text-on-surface truncate group-hover:text-primary-container transition-colors">${p.title}</span>
                <span class="font-mono text-xs text-secondary truncate">/catalogo/${p.slug}</span>
              </div>
            </div>
          </td>
          <td class="py-3 px-5">
            <span class="px-2.5 py-1 rounded bg-surface-container text-on-surface text-xs font-medium">${p.category}</span>
          </td>
          <td class="py-3 px-5">
            ${p.price && p.price.trim() ? `<span class="font-bold text-on-surface">${p.price}</span>` : '<span class="text-xs text-secondary/60 italic">Sin precio</span>'}
          </td>
          <td class="py-3 px-5 text-secondary text-xs">
            ${p.updatedAt || 'Reciente'}
          </td>
          <td class="py-3 px-5">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full ${p.status === 'published' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-surface-container-highest text-secondary border border-surface-container'} text-xs font-semibold">
              <span class="w-1.5 h-1.5 rounded-full ${p.status === 'published' ? 'bg-emerald-500' : 'bg-secondary'}"></span>
              ${p.status === 'published' ? 'Publicado' : 'Borrador'}
            </span>
          </td>
          <td class="py-3 px-5 text-right">
            <div class="flex items-center justify-end gap-1">
              <button class="p-1.5 rounded hover:bg-surface-container text-secondary hover:text-primary-container transition-colors" onclick="editProject('${p.id}')" title="Editar">
                <span class="material-symbols-outlined text-[18px]">edit</span>
              </button>
              <button class="p-1.5 rounded hover:bg-surface-container text-secondary hover:text-on-surface transition-colors" onclick="duplicateProject('${p.id}')" title="Duplicar">
                <span class="material-symbols-outlined text-[18px]">content_copy</span>
              </button>
              <a href="/#galeria" target="_blank" class="p-1.5 rounded hover:bg-surface-container text-secondary hover:text-on-surface transition-colors" title="Ver en vivo">
                <span class="material-symbols-outlined text-[18px]">visibility</span>
              </a>
              <button class="p-1.5 rounded hover:bg-error-container text-secondary hover:text-error transition-colors" onclick="deleteProject('${p.id}')" title="Eliminar">
                <span class="material-symbols-outlined text-[18px]">delete</span>
              </button>
            </div>
          </td>
        </tr>
      `).join('');

      updateCounters();
    }

    // Render Services Grid
    function renderServices() {
      const grid = document.getElementById('services-grid-body');
      if (!grid) return;

      if (!state.services || state.services.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full p-8 rounded-2xl bg-amber-50/70 border border-amber-200 text-center flex flex-col items-center justify-center gap-3">
            <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center">
              <span class="material-symbols-outlined text-[24px]">info</span>
            </div>
            <h4 class="font-bold text-slate-800 text-base">Sección de Servicios Desactivada</h4>
            <p class="text-xs text-slate-600 max-w-md">
              Actualmente la web pública no muestra la sección de servicios porque no hay servicios registrados. Si en el futuro deseas ofrecer paquetes especiales (como talleres presenciales o personalización mayorista), puedes agregar servicios aquí y la sección se activará automáticamente.
            </p>
            <button class="mt-2 px-4 py-2 bg-primary-container text-white text-xs font-bold rounded-lg shadow hover:bg-primary transition-all" onclick="openDrawerForNew('servicio')">
              + Activar Añadiendo un Servicio
            </button>
          </div>
        `;
        return;
      }

      grid.innerHTML = state.services.map(s => `
        <div class="bg-surface-container-low rounded-xl p-5 flex flex-col justify-between border border-surface-container hover:border-primary-container/40 transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-9 h-9 rounded-lg bg-tertiary-container/15 text-tertiary flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">${s.icon || 'diamond'}</span>
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-tertiary bg-tertiary/10 px-2 py-0.5 rounded">
                ${s.tag || 'Servicio'}
              </span>
            </div>
            <h4 class="font-bold text-on-surface text-sm mb-1.5">${s.title}</h4>
            <p class="text-xs text-secondary leading-relaxed mb-3">${s.description}</p>
            <div class="text-[11px] font-semibold text-on-surface bg-surface-container-lowest px-2.5 py-1.5 rounded-lg inline-block">
              ${s.priceEstimate || 'A cotizar'} • ${s.duration || 'Flexible'}
            </div>
          </div>
          <div class="flex items-center justify-end gap-2 mt-4 pt-3 border-t border-surface-container">
            <button class="text-xs text-secondary hover:text-primary-container font-semibold flex items-center gap-1" onclick="editService('${s.id}')">
              <span class="material-symbols-outlined text-[16px]">edit</span> Editar
            </button>
            <button class="text-xs text-secondary hover:text-error font-semibold flex items-center gap-1" onclick="deleteService('${s.id}')">
              <span class="material-symbols-outlined text-[16px]">delete</span> Eliminar
            </button>
          </div>
        </div>
      `).join('');
    }

    // Render Blog Posts
    function renderBlogPosts() {
      const grid = document.getElementById('blog-grid-body');
      if (!grid) return;

      grid.innerHTML = state.blogPosts.map(b => `
        <div class="bg-surface-container-low rounded-xl p-5 flex gap-4 border border-surface-container hover:border-primary-container/40 transition-all">
          <div class="w-20 h-20 rounded-lg overflow-hidden bg-surface-container shrink-0">
            <img class="w-full h-full object-cover" src="${b.image || '/images/bunu/logo.jpg'}"/>
          </div>
          <div class="flex flex-col justify-between flex-1">
            <div>
              <div class="flex items-center justify-between text-[11px] text-secondary mb-1">
                <span>${b.date || 'Reciente'}</span>
                <span class="font-semibold ${b.isFeatured ? 'text-primary-container' : ''}">${b.isFeatured ? 'Destacado' : ''}</span>
              </div>
              <h4 class="font-bold text-on-surface text-sm leading-snug mb-1">${b.title}</h4>
              <p class="text-xs text-secondary line-clamp-2">${b.excerpt || ''}</p>
            </div>
            <div class="flex items-center justify-end gap-2 mt-2">
              <button class="text-xs text-secondary hover:text-primary-container font-semibold flex items-center gap-1" onclick="editBlogPost('${b.id}')">
                <span class="material-symbols-outlined text-[16px]">edit</span> Editar
              </button>
              <button class="text-xs text-secondary hover:text-error font-semibold flex items-center gap-1" onclick="deleteBlogPost('${b.id}')">
                <span class="material-symbols-outlined text-[16px]">delete</span> Eliminar
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function updateCounters() {
      const projCount = state.projects.length;
      const draftCount = state.projects.filter(p => p.status === 'draft').length;
      
      const mProj = document.getElementById('metric-projects-count');
      const mDraft = document.getElementById('metric-drafts-count');
      const bProj = document.getElementById('tab-projects-badge');
      const mServ = document.getElementById('metric-services-count');
      const bServ = document.getElementById('tab-services-badge');

      if (mProj) mProj.textContent = projCount;
      if (mDraft) mDraft.textContent = `${draftCount} borradores guardados`;
      if (bProj) bProj.textContent = projCount;
      if (mServ) mServ.textContent = state.services.length;
      if (bServ) bServ.textContent = state.services.length;
    }

    // DRAWER LOGIC
    function openDrawerForNew(type) {
      document.getElementById('create-dropdown')?.classList.add('hidden');
      document.getElementById('item-id').value = '';
      document.getElementById('item-type').value = type;

      const titleEl = document.getElementById('drawer-title');
      const iconEl = document.getElementById('drawer-icon');
      const catGroup = document.getElementById('cat-price-group');
      const tagsGroup = document.getElementById('tags-group');
      const demoGroup = document.getElementById('demo-group');
      const imgGroup = document.getElementById('image-group');

      // Reset form
      document.getElementById('form-title').value = '';
      document.getElementById('form-desc').value = '';
      document.getElementById('form-image-url').value = '';
      document.getElementById('image-preview-badge').classList.add('hidden');
      document.getElementById('slug-preview').textContent = 'nuevo-accesorio';

      if (type === 'servicio') {
        titleEl.textContent = 'Añadir Nuevo Servicio';
        iconEl.textContent = 'design_services';
        catGroup.classList.remove('hidden');
        tagsGroup.classList.remove('hidden');
        demoGroup.classList.add('hidden');
        imgGroup.classList.add('hidden');
      } else if (type === 'articulo') {
        titleEl.textContent = 'Escribir Artículo de Blog';
        iconEl.textContent = 'edit_document';
        catGroup.classList.add('hidden');
        tagsGroup.classList.add('hidden');
        demoGroup.classList.add('hidden');
        imgGroup.classList.remove('hidden');
      } else {
        titleEl.textContent = 'Añadir Nuevo Accesorio';
        iconEl.textContent = 'gem';
        catGroup.classList.remove('hidden');
        tagsGroup.classList.remove('hidden');
        demoGroup.classList.remove('hidden');
        imgGroup.classList.remove('hidden');
      }

      document.getElementById('drawer-overlay')?.classList.remove('hidden');
    }

    function editProject(id) {
      const p = state.projects.find(item => item.id === id);
      if (!p) return;

      document.getElementById('item-id').value = p.id;
      document.getElementById('item-type').value = 'proyecto';
      document.getElementById('drawer-title').textContent = 'Editar Accesorio';
      document.getElementById('drawer-icon').textContent = 'edit';

      document.getElementById('form-title').value = p.title || '';
      document.getElementById('slug-preview').textContent = p.slug || '';
      document.getElementById('form-category').value = p.category || 'Tejido Miyuki & Mostacilla';
      document.getElementById('form-price').value = p.price || '';
      document.getElementById('form-desc').value = p.description || '';
      document.getElementById('form-tags').value = (p.tags || []).join(', ');
      document.getElementById('form-demo-url').value = p.demoUrl || '';
      document.getElementById('form-image-url').value = p.image || '';

      if (p.image) {
        document.getElementById('image-preview-thumb').src = p.image;
        document.getElementById('image-preview-badge').classList.remove('hidden');
      } else {
        document.getElementById('image-preview-badge').classList.add('hidden');
      }

      if (p.status === 'draft') {
        document.getElementById('radio-draft').checked = true;
      } else {
        document.getElementById('radio-published').checked = true;
      }

      document.getElementById('cat-price-group').classList.remove('hidden');
      document.getElementById('tags-group').classList.remove('hidden');
      document.getElementById('demo-group').classList.remove('hidden');
      document.getElementById('image-group').classList.remove('hidden');
      document.getElementById('drawer-overlay')?.classList.remove('hidden');
    }

    function editService(id) {
      const s = state.services.find(item => item.id === id);
      if (!s) return;

      document.getElementById('item-id').value = s.id;
      document.getElementById('item-type').value = 'servicio';
      document.getElementById('drawer-title').textContent = 'Editar Servicio';
      document.getElementById('drawer-icon').textContent = 'edit';

      document.getElementById('form-title').value = s.title || '';
      document.getElementById('form-price').value = s.priceEstimate || '';
      document.getElementById('form-desc').value = s.description || '';
      document.getElementById('form-tags').value = (s.bullets || []).join(', ');

      document.getElementById('cat-price-group').classList.remove('hidden');
      document.getElementById('tags-group').classList.remove('hidden');
      document.getElementById('demo-group').classList.add('hidden');
      document.getElementById('image-group').classList.add('hidden');
      document.getElementById('drawer-overlay')?.classList.remove('hidden');
    }

    function editBlogPost(id) {
      const b = state.blogPosts.find(item => item.id === id);
      if (!b) return;

      document.getElementById('item-id').value = b.id;
      document.getElementById('item-type').value = 'articulo';
      document.getElementById('drawer-title').textContent = 'Editar Artículo';
      document.getElementById('drawer-icon').textContent = 'edit';

      document.getElementById('form-title').value = b.title || '';
      document.getElementById('form-desc').value = b.excerpt || '';
      document.getElementById('form-image-url').value = b.image || '';

      if (b.image) {
        document.getElementById('image-preview-thumb').src = b.image;
        document.getElementById('image-preview-badge').classList.remove('hidden');
      }

      document.getElementById('cat-price-group').classList.add('hidden');
      document.getElementById('tags-group').classList.add('hidden');
      document.getElementById('demo-group').classList.add('hidden');
      document.getElementById('image-group').classList.remove('hidden');
      document.getElementById('drawer-overlay')?.classList.remove('hidden');
    }

    function closeDrawer() {
      document.getElementById('drawer-overlay')?.classList.add('hidden');
    }

    // Commit item from drawer
    async function commitDrawerItem() {
      const id = document.getElementById('item-id').value;
      const type = document.getElementById('item-type').value;
      const title = document.getElementById('form-title').value.trim();
      const desc = document.getElementById('form-desc').value.trim();
      const status = document.getElementById('radio-draft').checked ? 'draft' : 'published';

      if (!title) {
        alert('Por favor introduce un nombre para la pieza o contenido.');
        return;
      }

      if (type === 'proyecto') {
        const category = document.getElementById('form-category').value;
        const price = (document.getElementById('form-price').value || '').trim();
        const image = document.getElementById('form-image-url').value || '/images/bunu/logo.jpg';
        const rawDemoUrl = document.getElementById('form-demo-url').value;
        const defaultWhatsAppBuy = `https://wa.me/573160771180?text=Hola%20Bunu%20Shop,%20me%20interesa%20comprar:%20${encodeURIComponent(title)}`;
        const demoUrl = rawDemoUrl || defaultWhatsAppBuy;
        const buyUrl = defaultWhatsAppBuy;
        const rawTags = document.getElementById('form-tags').value;
        const tags = rawTags ? rawTags.split(',').map(t => t.trim()).filter(Boolean) : ['Hecho a mano', 'Bunu Shop'];
        const slug = document.getElementById('slug-preview').textContent || title.toLowerCase().replace(/[^a-z0-9]+/g, '-');

        if (id) {
          // Update
          const p = state.projects.find(item => item.id === id);
          if (p) {
            Object.assign(p, { title, slug, category, price, image, description: desc, tags, demoUrl, buyUrl, status, updatedAt: 'Recién editado' });
          }
        } else {
          // Add new
          state.projects.unshift({
            id: 'prj-' + Date.now(),
            slug,
            title,
            category,
            price,
            rating: '5.0',
            downloads: 'Exclusivo',
            image,
            description: desc,
            tags,
            demoUrl,
            buyUrl,
            status,
            updatedAt: 'Hoy, ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
          });
        }
        renderProjectsTable();
      } else if (type === 'servicio') {
        const priceEstimate = (document.getElementById('form-price').value || '').trim();
        const rawBullets = document.getElementById('form-tags').value;
        const bullets = rawBullets ? rawBullets.split(',').map(t => t.trim()).filter(Boolean) : [];

        if (id) {
          const s = state.services.find(item => item.id === id);
          if (s) Object.assign(s, { title, description: desc, priceEstimate, bullets });
        } else {
          state.services.push({
            id: 'srv-' + Date.now(),
            slug: title.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
            title,
            tag: 'Servicio',
            icon: 'diamond',
            priceEstimate,
            duration: 'A medida',
            description: desc,
            bullets,
            active: true
          });
        }
        renderServices();
      } else if (type === 'articulo') {
        const image = document.getElementById('form-image-url').value || '/images/bunu/logo.jpg';
        if (id) {
          const b = state.blogPosts.find(item => item.id === id);
          if (b) Object.assign(b, { title, excerpt: desc, image, status });
        } else {
          state.blogPosts.unshift({
            id: 'post-' + Date.now(),
            slug: title.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
            title,
            excerpt: desc,
            date: new Date().toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase(),
            comments: 'TIPS BUNU',
            image,
            isFeatured: false,
            status
          });
        }
        renderBlogPosts();
      }

      closeDrawer();
      await persistDataToBlob();
    }

    function duplicateProject(id) {
      const p = state.projects.find(item => item.id === id);
      if (!p) return;

      const clone = {
        ...p,
        id: 'prj-' + Date.now(),
        title: p.title + ' (Copia)',
        slug: p.slug + '-copia',
        status: 'draft',
        updatedAt: 'Borrador duplicado'
      };

      state.projects.unshift(clone);
      renderProjectsTable();
      showToast('Accesorio duplicado', 'Se ha creado una copia en borrador.');
      persistDataToBlob();
    }

    function deleteProject(id) {
      if (!confirm('¿Estás seguro de eliminar este accesorio del catálogo?')) return;
      state.projects = state.projects.filter(p => p.id !== id);
      renderProjectsTable();
      showToast('Accesorio eliminado', 'La pieza ha sido removida del catálogo.');
      persistDataToBlob();
    }

    function deleteService(id) {
      if (!confirm('¿Estás seguro de eliminar este servicio?')) return;
      state.services = state.services.filter(s => s.id !== id);
      renderServices();
      showToast('Servicio eliminado', 'El servicio ha sido removido.');
      persistDataToBlob();
    }

    function deleteBlogPost(id) {
      if (!confirm('¿Estás seguro de eliminar este post?')) return;
      state.blogPosts = state.blogPosts.filter(b => b.id !== id);
      renderBlogPosts();
      showToast('Artículo eliminado', 'El post ha sido removido del blog.');
      persistDataToBlob();
    }

    // Save site general config
    async function saveSiteConfig() {
      state.siteInfo.name = document.getElementById('cfg-name').value;
      state.siteInfo.owner = document.getElementById('cfg-owner').value;
      state.siteInfo.role = document.getElementById('cfg-role').value;
      state.siteInfo.experience = document.getElementById('cfg-exp').value;
      state.siteInfo.contactPhone = document.getElementById('cfg-phone').value;
      state.siteInfo.contactEmail = document.getElementById('cfg-email').value;
      state.siteInfo.heroTitle1 = document.getElementById('cfg-hero1').value;
      state.siteInfo.heroTitle2 = document.getElementById('cfg-hero2').value;
      state.siteInfo.heroTitleHighlight = document.getElementById('cfg-hero-high').value;
      state.siteInfo.heroTitle3 = document.getElementById('cfg-hero3').value;
      state.siteInfo.aboutBio1 = document.getElementById('cfg-bio1').value;

      await persistDataToBlob();
    }

    // PERSISTENCE TO VERCEL BLOB VIA ASTRO SERVERLESS API
    async function persistDataToBlob() {
      const topBtn = document.getElementById('top-sync-btn');
      const drawerBtn = document.getElementById('drawer-save-btn');
      const originalText = topBtn?.innerHTML;

      if (topBtn) {
        topBtn.disabled = true;
        topBtn.innerHTML = `<span class="material-symbols-outlined text-[18px] animate-spin">sync</span><span>Sincronizando...</span>`;
      }
      if (drawerBtn) drawerBtn.disabled = true;

      try {
        const res = await fetch('/api/portafolio', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(state, null, 2)
        });

        const result = await res.json();

        if (res.ok && result.success) {
          const syncLabel = document.getElementById('sync-time-label');
          if (syncLabel) syncLabel.textContent = `Actualizado: ${new Date().toLocaleTimeString()}`;
          showToast('¡Guardado exitoso!', result.message || 'Los cambios se han guardado en Vercel Blob.');
        } else {
          showToast('Error al guardar', result.error || 'No se pudo guardar la información.', true);
        }
      } catch (err) {
        console.error('Error de red al sincronizar:', err);
        showToast('Error de conexión', 'Comprueba que el servidor Astro esté en ejecución.', true);
      } finally {
        if (topBtn) {
          topBtn.disabled = false;
          topBtn.innerHTML = originalText;
        }
        if (drawerBtn) drawerBtn.disabled = false;
      }
    }

    // Setup Image Upload
    function setupImageUpload() {
      const dropzone = document.getElementById('dropzone');
      const fileInput = document.getElementById('file-input');
      const imageUrlInput = document.getElementById('form-image-url');
      const previewBadge = document.getElementById('image-preview-badge');
      const previewThumb = document.getElementById('image-preview-thumb');

      if (!dropzone || !fileInput) return;

      dropzone.addEventListener('click', () => fileInput.click());

      dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropzone.classList.add('border-primary-container', 'bg-primary-container/5');
      });

      dropzone.addEventListener('dragleave', () => {
        dropzone.classList.remove('border-primary-container', 'bg-primary-container/5');
      });

      dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('border-primary-container', 'bg-primary-container/5');
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
          uploadSelectedFile(e.dataTransfer.files[0]);
        }
      });

      fileInput.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          uploadSelectedFile(e.target.files[0]);
        }
      });

      if (imageUrlInput) {
        imageUrlInput.addEventListener('input', (e) => {
          const url = e.target.value.trim();
          if (url) {
            previewThumb.src = url;
            previewBadge.classList.remove('hidden');
          } else {
            previewBadge.classList.add('hidden');
          }
        });
      }
    }

    async function uploadSelectedFile(file) {
      const dropzone = document.getElementById('dropzone');
      const imageUrlInput = document.getElementById('form-image-url');
      const previewBadge = document.getElementById('image-preview-badge');
      const previewThumb = document.getElementById('image-preview-thumb');

      dropzone.innerHTML = `
        <div class="flex items-center gap-2 text-primary-container">
          <span class="material-symbols-outlined animate-spin text-[20px]">sync</span>
          <span class="text-xs font-semibold">Subiendo foto a Vercel Blob...</span>
        </div>
      `;

      try {
        const formData = new FormData();
        formData.append('file', file);

        const res = await fetch('/api/upload', {
          method: 'POST',
          body: formData
        });

        const data = await res.json();

        if (res.ok && data.url) {
          imageUrlInput.value = data.url;
          previewThumb.src = data.url;
          previewBadge.classList.remove('hidden');
          showToast('Foto subida', 'La foto está lista para vincularse al accesorio.');
        } else {
          alert('Error al subir foto: ' + (data.error || 'Desconocido'));
        }
      } catch (err) {
        console.error('Error al subir:', err);
        alert('Error de conexión al subir la foto.');
      } finally {
        dropzone.innerHTML = `
          <input type="file" id="file-input" class="hidden" accept="image/*"/>
          <div class="w-10 h-10 rounded-full bg-primary-container/10 text-primary-container flex items-center justify-center mb-2">
            <span class="material-symbols-outlined text-[20px]">cloud_upload</span>
          </div>
          <span class="text-xs font-semibold text-on-surface">Haz clic para cambiar foto o arrastra otra aquí</span>
          <span class="text-[11px] text-secondary mt-0.5">Sube directamente a Vercel Blob</span>
        `;
        document.getElementById('file-input')?.addEventListener('change', (e) => {
          if (e.target.files && e.target.files[0]) uploadSelectedFile(e.target.files[0]);
        });
      }
    }

    // Floating Toast Notification
    function showToast(title, msg, isError = false) {
      const toast = document.getElementById('toast');
      const toastTitle = document.getElementById('toast-title');
      const toastMsg = document.getElementById('toast-msg');

      if (!toast) return;

      toastTitle.textContent = title;
      toastMsg.textContent = msg;

      const iconContainer = toast.querySelector('div');
      if (isError) {
        iconContainer.className = 'w-9 h-9 rounded-full bg-rose-500 text-white flex items-center justify-center shrink-0';
        iconContainer.innerHTML = `<span class="material-symbols-outlined text-[20px]">priority_high</span>`;
      } else {
        iconContainer.className = 'w-9 h-9 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0';
        iconContainer.innerHTML = `<span class="material-symbols-outlined text-[20px]">check</span>`;
      }

      toast.classList.remove('hidden', 'translate-y-4');
      setTimeout(() => {
        toast.classList.add('translate-y-4', 'hidden');
      }, 4000);
    }

    // Logout Handler
    async function handleLogout() {
      if (!confirm('¿Estás seguro de que deseas cerrar sesión en el panel?')) return;
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      } catch (err) {
        console.error('Error al cerrar sesión:', err);
        window.location.href = '/admin/login';
      }
    }
  </script>

