---
import { getPortfolioData } from '../../lib/storage';
import '../../styles/global.css';

export const prerender = false;

const initialData = await getPortfolioData();
const hasBlobToken = Boolean(process.env.BLOB_READ_WRITE_TOKEN);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>BUNU SHOP Studio - Panel de Administración</title>

  <!-- Fonts: Plus Jakarta Sans, JetBrains Mono, Google Material Symbols -->
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>


  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      vertical-align: middle;
    }
  </style>
</head>

<body class="bg-background text-on-surface min-h-screen">

  <!-- Inject Initial Data for Client-Side Interactivity -->
  <script id="initial-data" type="application/json" set:html={JSON.stringify(initialData)}></script>

  <!-- Left Sidebar Navigation Rail -->
  <aside class="fixed left-0 top-0 h-full w-[260px] bg-inverse-surface text-inverse-on-surface z-50 flex flex-col justify-between py-6">
    <div class="flex flex-col gap-6">
      <!-- Brand Header -->
      <div class="px-6 flex items-center justify-between">
        <a href="/admin" class="flex items-center gap-3">
          <img 
            src="/images/bunu/logo.jpg" 
            alt="Bunu Shop" 
            class="w-10 h-10 rounded-full object-cover border border-pink-400/40 shadow-sm"
          />
          <div class="flex flex-col">
            <span class="font-bold text-lg tracking-tight text-white leading-none font-display">BUNU SHOP</span>
            <span class="text-[10px] tracking-wider uppercase text-pink-300 mt-0.5">Admin Studio</span>
          </div>
        </a>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex flex-col gap-1.5 px-3">
        <button data-nav="general" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-lg transition-all bg-primary-container text-on-primary-container font-semibold text-sm w-full text-left">
          <span class="material-symbols-outlined text-[20px]">space_dashboard</span>
          <span>Catálogo General</span>
        </button>
        <button data-nav="proyectos" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-lg text-secondary-fixed-dim hover:bg-white/10 hover:text-white transition-all font-medium text-sm w-full text-left">
          <span class="material-symbols-outlined text-[20px]">gem</span>
          <span>Productos &amp; Accesorios</span>
        </button>
        <button data-nav="servicios" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-lg text-secondary-fixed-dim hover:bg-white/10 hover:text-white transition-all font-medium text-sm w-full text-left">
          <span class="material-symbols-outlined text-[20px]">design_services</span>
          <span>Servicios</span>
        </button>
        <button data-nav="blog" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-lg text-secondary-fixed-dim hover:bg-white/10 hover:text-white transition-all font-medium text-sm w-full text-left">
          <span class="material-symbols-outlined text-[20px]">edit_document</span>
          <span>Blog &amp; Consejos</span>
        </button>
        <button data-nav="config" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-lg text-secondary-fixed-dim hover:bg-white/10 hover:text-white transition-all font-medium text-sm w-full text-left">
          <span class="material-symbols-outlined text-[20px]">tune</span>
          <span>Información de Tienda</span>
        </button>
      </nav>
    </div>

    <!-- Bottom Actions -->
    <div class="px-4 flex flex-col gap-3">
      <div class="p-3 rounded-lg bg-white/5 flex flex-col gap-2 border border-white/10">
        <span class="text-[11px] text-pink-200 uppercase tracking-wider font-semibold">Acceso Directo</span>
        <a class="flex items-center justify-between text-white text-xs hover:text-pink-300 transition-colors font-medium" href="/" target="_blank">
          <span>Ver Tienda en Vivo</span>
          <span class="material-symbols-outlined text-[16px]">open_in_new</span>
        </a>
        <button onclick="handleLogout()" class="mt-1 flex items-center justify-between text-rose-300 hover:text-rose-100 text-xs font-semibold transition-colors pt-2 border-t border-white/10">
          <span class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">logout</span>
            <span>Cerrar Sesión</span>
          </span>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        </button>
      </div>
      
      <!-- Persistence Status Badge -->
      <div class="px-2 py-1.5 rounded-lg bg-black/30 text-[11px] flex items-center justify-between">
        <span class="text-pink-200">Almacenamiento:</span>
        <span class={`font-bold ${hasBlobToken ? 'text-emerald-400' : 'text-amber-300'}`}>
          {hasBlobToken ? 'Vercel Blob' : 'Local Fallback'}
        </span>
      </div>

      <div class="px-2 pt-1 flex items-center justify-between text-pink-300/60 text-xs">
        <span>v2.4 Bunu Shop</span>
        <a href="/" target="_blank" class="hover:text-white"><span class="material-symbols-outlined text-[16px]">help_outline</span></a>
      </div>
    </div>
  </aside>

  <!-- Main Content Layout -->
  <div class="pl-[260px]">
    
    <!-- Top Bar Header -->
    <header class="fixed top-0 left-[260px] right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-xl border-b border-surface-container z-40 flex items-center justify-between px-8">
      <div class="flex items-center gap-4 w-full max-w-md">
        <div class="relative w-full flex items-center">
          <span class="material-symbols-outlined absolute left-3 text-secondary text-[20px]">search</span>
          <input id="global-search" class="w-full pl-10 pr-4 py-2 h-10 bg-surface-container-low border-0 rounded-lg text-on-surface placeholder:text-secondary text-sm focus:outline-none focus:ring-2 focus:ring-primary-container/20" placeholder="Buscar accesorios, productos o posts..." type="text"/>
        </div>
      </div>

      <div class="flex items-center gap-5">
        <!-- Live Status Pill -->
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs text-emerald-800 font-semibold">Tienda Online Activa</span>
        </div>

        <!-- Direct Save Changes Button -->
        <button id="top-sync-btn" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-container hover:bg-primary text-on-primary-container text-xs font-bold shadow transition-all">
          <span class="material-symbols-outlined text-[18px]">cloud_sync</span>
          <span>Guardar Cambios</span>
        </button>

        <!-- User Profile Info -->
        <div class="flex items-center gap-3 pl-3 border-l border-surface-container">
          <div class="flex flex-col text-right">
            <span class="text-sm font-semibold text-on-surface leading-tight">{initialData.siteInfo.owner || 'Mary Sorely'}</span>
            <span class="text-[11px] text-primary-container font-semibold">{initialData.siteInfo.name}</span>
          </div>
          <img 
            src="/images/bunu/Perfil.jpeg" 
            alt="Mary Sorely" 
            class="w-9 h-9 rounded-full object-cover border border-pink-300 shadow-sm"
          />
          <button onclick="handleLogout()" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors ml-1" title="Cerrar Sesión">
            <span class="material-symbols-outlined text-[20px]">logout</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="relative pt-20 pb-16 bg-background min-h-screen px-8">
      <div class="w-full max-w-[1280px] mx-auto flex flex-col gap-8">

        <!-- Title & Action Bar -->
        <section class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2">
              <span class="text-xs uppercase tracking-wider text-primary-container font-bold">Accesorios Bunu Shop</span>
              <span class="text-secondary">•</span>
              <span class="text-xs text-secondary">Edición en Tiempo Real</span>
            </div>
            <h1 class="text-3xl font-bold text-on-surface">Panel de Control de Catálogo</h1>
            <p class="text-sm text-secondary max-w-2xl">
              Gestiona tus piezas artesanales, fotos, precios, pedidos por WhatsApp y publicaciones editoriales.
            </p>
          </div>

          <div class="flex items-center gap-3 self-start md:self-auto relative">
            <a class="flex items-center gap-2 px-4 h-10 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface text-xs font-bold shadow-sm transition-all" href="/" target="_blank">
              <span>Ver Tienda</span>
              <span class="material-symbols-outlined text-[16px]">open_in_new</span>
            </a>

            <!-- Create Dropdown Trigger -->
            <div class="relative inline-block text-left" id="create-menu-container">
              <button class="flex items-center gap-2 px-4 h-10 rounded-lg bg-primary-container hover:bg-primary text-on-primary-container text-xs font-bold shadow transition-all" id="create-btn">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>+ Crear Contenido</span>
                <span class="material-symbols-outlined text-[16px]">expand_more</span>
              </button>
              
              <!-- Dropdown Menu -->
              <div class="hidden absolute right-0 mt-2 w-60 rounded-xl bg-surface-container-lowest shadow-xl p-1.5 z-30 border border-surface-container flex flex-col gap-1" id="create-dropdown">
                <button class="flex items-center gap-3 px-3 py-2 rounded-lg text-left text-on-surface hover:bg-surface-container-low transition-colors text-xs font-semibold w-full" onclick="openDrawerForNew('proyecto')">
                  <span class="material-symbols-outlined text-primary-container text-[20px]">gem</span>
                  <div>
                    <div>Nuevo Producto</div>
                    <div class="text-secondary text-[10px] font-normal">Pulsera, collar, mostacilla</div>
                  </div>
                </button>
                <button class="flex items-center gap-3 px-3 py-2 rounded-lg text-left text-on-surface hover:bg-surface-container-low transition-colors text-xs font-semibold w-full" onclick="openDrawerForNew('servicio')">
                  <span class="material-symbols-outlined text-tertiary text-[20px]">design_services</span>
                  <div>
                    <div>Nuevo Servicio</div>
                    <div class="text-secondary text-[10px] font-normal">Talleres o personalización</div>
                  </div>
                </button>
                <button class="flex items-center gap-3 px-3 py-2 rounded-lg text-left text-on-surface hover:bg-surface-container-low transition-colors text-xs font-semibold w-full" onclick="openDrawerForNew('articulo')">
                  <span class="material-symbols-outlined text-secondary text-[20px]">article</span>
                  <div>
                    <div>Nuevo Post de Blog</div>
                    <div class="text-secondary text-[10px] font-normal">Tips de cuidado y tendencias</div>
                  </div>
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- Metric Overview Cards -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-surface-container flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-secondary">Accesorios en Catálogo</span>
              <div class="w-9 h-9 rounded-lg bg-primary-container/10 flex items-center justify-center text-primary-container">
                <span class="material-symbols-outlined text-[20px]">gem</span>
              </div>
            </div>
            <div class="mt-3">
              <div class="flex items-baseline gap-2">
                <span class="text-2xl font-bold text-on-surface" id="metric-projects-count">{initialData.projects.length}</span>
                <span class="text-[11px] text-brand-darkNavy bg-brand-pinkLight border border-pink-200/80 px-2 py-0.5 rounded-full font-semibold">Total</span>
              </div>
              <span class="text-xs text-secondary mt-1 block" id="metric-drafts-count">
                {initialData.projects.filter((p: any) => p.status === 'draft').length} borradores guardados
              </span>
            </div>
          </div>

          <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-surface-container flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-secondary">Estado de Servicios</span>
              <div class="w-9 h-9 rounded-lg bg-tertiary-container/10 flex items-center justify-center text-tertiary">
                <span class="material-symbols-outlined text-[20px]">design_services</span>
              </div>
            </div>
            <div class="mt-3">
              <div class="flex items-baseline gap-2">
                <span class="text-2xl font-bold text-on-surface" id="metric-services-count">{initialData.services.length}</span>
                <span class={`text-[11px] ${initialData.services.length > 0 ? 'text-brand-lavenderDark bg-purple-50 border border-purple-200/80' : 'text-slate-600 bg-slate-100 border border-slate-200'} px-2 py-0.5 rounded-full font-semibold`}>
                  {initialData.services.length > 0 ? 'Activo' : 'Desactivado'}
                </span>
              </div>
              <span class="text-xs text-secondary mt-1 block">
                {initialData.services.length > 0 ? 'Visible en la tienda' : 'Oculto por defecto'}
              </span>
            </div>
          </div>

          <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-surface-container flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-secondary">Artículos de Blog</span>
              <div class="w-9 h-9 rounded-lg bg-secondary-container/30 flex items-center justify-center text-secondary">
                <span class="material-symbols-outlined text-[20px]">auto_stories</span>
              </div>
            </div>
            <div class="mt-3">
              <div class="flex items-baseline gap-2">
                <span class="text-2xl font-bold text-on-surface" id="metric-blog-count">{initialData.blogPosts.length}</span>
                <span class="text-[11px] text-brand-lavenderDark bg-purple-50 border border-purple-200/80 px-2 py-0.5 rounded-full font-semibold">Publicados</span>
              </div>
              <span class="text-xs text-secondary mt-1 block">Guías y tips de cuidado</span>
            </div>
          </div>

          <div class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-surface-container flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-secondary">Sincronización Web</span>
              <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">sync</span>
              </div>
            </div>
            <div class="mt-3">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-sm font-semibold text-on-surface">Vercel Blob / JSON</span>
              </div>
              <span class="text-xs text-secondary mt-1 block" id="sync-time-label">Listo para guardar</span>
            </div>
          </div>
        </section>

        <!-- Content Management Center with Tabs -->
        <section class="flex flex-col bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container overflow-hidden">
          
          <!-- Tab Navigation Bar -->
          <div class="flex items-center justify-between px-6 pt-3 bg-surface-container-low border-b border-surface-container">
            <div class="flex items-center gap-2 overflow-x-auto">
              <button data-content-tab="projects" class="content-tab px-4 py-2.5 rounded-t-lg bg-surface-container-lowest text-primary-container font-semibold text-xs flex items-center gap-2 border-t-2 border-primary-container shadow-sm">
                <span class="material-symbols-outlined text-[18px]">gem</span>
                <span>Catálogo de Accesorios</span>
                <span class="px-2 py-0.5 text-[10px] rounded-full bg-primary-container/10 font-bold" id="tab-projects-badge">{initialData.projects.length}</span>
              </button>
              <button data-content-tab="services" class="content-tab px-4 py-2.5 rounded-t-lg text-secondary hover:text-on-surface hover:bg-surface-container-lowest/50 font-medium text-xs flex items-center gap-2 transition-all">
                <span class="material-symbols-outlined text-[18px]">design_services</span>
                <span>Servicios</span>
                <span class="px-2 py-0.5 text-[10px] rounded-full bg-surface-container font-medium" id="tab-services-badge">{initialData.services.length}</span>
              </button>
              <button data-content-tab="blog" class="content-tab px-4 py-2.5 rounded-t-lg text-secondary hover:text-on-surface hover:bg-surface-container-lowest/50 font-medium text-xs flex items-center gap-2 transition-all">
                <span class="material-symbols-outlined text-[18px]">edit_document</span>
                <span>Blog &amp; Consejos</span>
                <span class="px-2 py-0.5 text-[10px] rounded-full bg-surface-container font-medium" id="tab-blog-badge">{initialData.blogPosts.length}</span>
              </button>
              <button data-content-tab="config" class="content-tab px-4 py-2.5 rounded-t-lg text-secondary hover:text-on-surface hover:bg-surface-container-lowest/50 font-medium text-xs flex items-center gap-2 transition-all">
                <span class="material-symbols-outlined text-[18px]">tune</span>
                <span>Configuración de Tienda</span>
              </button>
            </div>
            
            <div class="hidden lg:flex items-center gap-2 text-secondary text-xs pb-2">
              <span class="material-symbols-outlined text-[16px]">touch_app</span>
              <span>Haz clic en un producto para editarlo</span>
            </div>
          </div>

          <!-- TAB 1: PROJECTS VIEW -->
          <div id="tab-view-projects" class="tab-view flex flex-col">
            <!-- Filter & Search Toolbar -->
            <div class="p-4 flex flex-col md:flex-row items-center justify-between gap-3 bg-surface-container-lowest border-b border-surface-container">
              <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                <div class="relative w-full sm:w-72">
                  <span class="material-symbols-outlined absolute left-3 top-2.5 text-secondary text-[18px]">search</span>
                  <input id="table-search" class="w-full pl-9 pr-3 py-2 bg-surface-container-low rounded-lg text-on-surface placeholder:text-secondary text-xs focus:outline-none focus:ring-2 focus:ring-primary-container/30" placeholder="Buscar por nombre o descripción..." type="text"/>
                </div>
                
                <div class="relative">
                  <select id="table-filter-cat" class="appearance-none bg-surface-container-low text-on-surface text-xs px-3 py-2 pr-8 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-container/30 cursor-pointer">
                    <option value="all">Todas las Categorías</option>
                    <option value="Tejido Miyuki & Mostacilla">Tejido Miyuki &amp; Mostacilla</option>
                    <option value="Pulseras Personalizadas">Pulseras Personalizadas</option>
                    <option value="Protección & Religioso">Protección &amp; Religioso</option>
                    <option value="Dúos & Parejas">Dúos &amp; Parejas</option>
                  </select>
                  <span class="material-symbols-outlined absolute right-2 top-2 text-secondary text-[18px] pointer-events-none">expand_more</span>
                </div>

                <div class="relative">
                  <select id="table-filter-status" class="appearance-none bg-surface-container-low text-on-surface text-xs px-3 py-2 pr-8 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-container/30 cursor-pointer">
                    <option value="all">Todos los Estados</option>
                    <option value="published">Publicado</option>
                    <option value="draft">Borrador</option>
                  </select>
                  <span class="material-symbols-outlined absolute right-2 top-2 text-secondary text-[18px] pointer-events-none">expand_more</span>
                </div>
              </div>

              <button class="flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-container hover:bg-primary text-on-primary-container text-xs font-bold shadow-sm transition-all w-full md:w-auto justify-center" onclick="openDrawerForNew('proyecto')">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>+ Añadir Accesorio</span>
              </button>
            </div>

            <!-- Interactive Table -->
            <div class="overflow-x-auto">
              <table class="w-full text-left text-on-surface border-collapse">
                <thead class="bg-surface-container-low text-secondary text-[11px] uppercase tracking-wider">
                  <tr>
                    <th class="py-3 px-5 font-semibold">Producto / Accesorio</th>
                    <th class="py-3 px-5 font-semibold">Categoría</th>
                    <th class="py-3 px-5 font-semibold">Precio</th>
                    <th class="py-3 px-5 font-semibold">Última Actualización</th>
                    <th class="py-3 px-5 font-semibold">Estado</th>
                    <th class="py-3 px-5 font-semibold text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="projects-table-body" class="divide-y divide-surface-container-low text-sm">
                  <!-- Populated dynamically via JS -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- TAB 2: SERVICES VIEW -->
          <div id="tab-view-services" class="tab-view hidden p-6 flex flex-col gap-4">
            <div class="flex items-center justify-between mb-2">
              <div>
                <h3 class="text-lg font-bold text-on-surface">Servicios &amp; Paquetes Especiales</h3>
                <p class="text-xs text-secondary">Por ahora la sección está desactivada en la web pública por no tener información registrada.</p>
              </div>
              <button class="flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-container hover:bg-primary text-on-primary-container text-xs font-bold transition-all" onclick="openDrawerForNew('servicio')">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>+ Añadir Servicio</span>
              </button>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="services-grid-body">
              <!-- Populated dynamically via JS -->
            </div>
          </div>

          <!-- TAB 3: BLOG VIEW -->
          <div id="tab-view-blog" class="tab-view hidden p-6 flex flex-col gap-4">
            <div class="flex items-center justify-between mb-2">
              <div>
                <h3 class="text-lg font-bold text-on-surface">Artículos &amp; Consejos de Joyería</h3>
                <p class="text-xs text-secondary">Comparte recomendaciones de cuidado para mostacilla, hilos y significados.</p>
              </div>
              <button class="flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-container hover:bg-primary text-on-primary-container text-xs font-bold transition-all" onclick="openDrawerForNew('articulo')">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>+ Escribir Post</span>
              </button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="blog-grid-body">
              <!-- Populated dynamically via JS -->
            </div>
          </div>

          <!-- TAB 4: CONFIG / SITE INFO VIEW -->
          <div id="tab-view-config" class="tab-view hidden p-6 flex flex-col gap-6">
            <div>
              <h3 class="text-lg font-bold text-on-surface">Información General de la Tienda</h3>
              <p class="text-xs text-secondary">Edita los textos del Hero, sobre la marca, WhatsApp y enlaces sociales.</p>
            </div>
            
