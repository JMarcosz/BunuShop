  <meta name="twitter:title" content="Bunu Shop | Accesorios Hechos a Mano y Joyería Personalizada"/>
  <meta name="twitter:description" content="Piezas únicas tejidas a mano en Colombia con mostacilla calibrada y baño de oro. Personaliza tu diseño con visto bueno previo y envío seguro."/>
  <meta name="twitter:image" content={`${siteUrl}/images/bunu/logo.jpg`}/>

  <!-- Structured Data JSON-LD (SEO, GEO & AEO) -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaJewelryStore)}/>
  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)}/>
  <script type="application/ld+json" set:html={JSON.stringify(schemaHowTo)}/>
  
  <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  
  
  <style>
    /* Sutiles líneas diagonales de acento en tono rosa/fucsia de la marca */
    .decor-line-diagonal {
      position: relative;
    }
    .decor-line-diagonal::before {
      content: '';
      position: absolute;
      width: 45px;
      height: 2px;
      background-color: #ec4899;
      transform: rotate(-35deg);
      top: -14px;
      left: 0;
    }
    .decor-line-diagonal-right {
      position: relative;
    }
    .decor-line-diagonal-right::after {
      content: '';
      position: absolute;
      width: 50px;
      height: 2px;
      background-color: #ec4899;
      transform: rotate(-30deg);
      top: -12px;
      right: 0;
    }
    .custom-shadow {
      box-shadow: 0 20px 40px -15px rgba(236, 72, 153, 0.08);
    }
  </style>
</head>
<body class="bg-white text-slate-800 font-sans antialiased selection:bg-brand-pink selection:text-white">

  <!-- BEGIN: Navigation -->
