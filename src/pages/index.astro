  <!-- BEGIN: Interactive Client-Side Scripts -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // Mobile menu toggle
      const toggleBtn = document.getElementById('menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');

      if (toggleBtn && mobileMenu) {
        toggleBtn.addEventListener('click', function () {
          mobileMenu.classList.toggle('hidden');
        });

        mobileMenu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
          });
        });
      }

      // Scroll-reveal animations (fade + slide-up al entrar en viewport)
      const revealEls = document.querySelectorAll('.reveal');
      if (revealEls.length > 0) {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          revealEls.forEach(el => el.classList.add('reveal-visible'));
        } else {
          const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.1,
            rootMargin: '0px 0px -10% 0px'
          });

          revealEls.forEach(el => revealObserver.observe(el));
        }
      }

      // Filter, Search & Pagination logic (Estilo Amazon / eBay)
      const filterBtns = document.querySelectorAll('.filter-btn');
      const searchInput = document.getElementById('gallery-search');
      const sortSelect = document.getElementById('gallery-sort');
      const cards = Array.from(document.querySelectorAll('.project-card'));
      const grid = document.getElementById('projects-grid');
      const noResults = document.getElementById('no-results');
      const visibleCount = document.getElementById('visible-count');

      // Pagination DOM Elements
      const paginationContainer = document.getElementById('catalog-pagination-container');
      const paginationNav = document.getElementById('pagination-nav');
      const paginationNumbers = document.getElementById('pagination-numbers');
      const btnPrev = document.getElementById('btn-prev-page');
      const btnNext = document.getElementById('btn-next-page');
      const pFrom = document.getElementById('pagination-from');
      const pTo = document.getElementById('pagination-to');
      const pTotal = document.getElementById('pagination-total');
      const pIndicator = document.getElementById('pagination-page-indicator');
      const pViewMode = document.getElementById('pagination-view-mode');

      let currentCategory = 'all';
      let currentSearch = '';
      let currentPage = 1;

      // Determinación responsiva de items por página:
      // 1. Resolución más grande (>= 1280px, xl): 8 productos (2 secciones de 4)
      // 2. Desktop/Laptop (>= 1024px y < 1280px, lg): 6 productos (2 secciones de 3)
      // 3. Tablet/Móvil horizontal (>= 640px y < 1024px, sm/md): 4 productos (2 secciones de 2)
      // 4. Resolución más pequeña móvil (< 640px): 4 productos (1 sección de 4)
      function getItemsPerPage() {
        const width = window.innerWidth;
        if (width >= 1280) {
          return { limit: 8, label: '8 por página (2 secciones de 4)' };
        } else if (width >= 1024) {
          return { limit: 6, label: '6 por página (2 secciones de 3)' };
        } else if (width >= 640) {
          return { limit: 4, label: '4 por página (2 secciones de 2)' };
        } else {
          return { limit: 4, label: '4 por página (1 sección de 4)' };
        }
      }

      function updateGallery(shouldScroll = false) {
        // 1. Filtrar tarjetas según categoría activa y término de búsqueda
        const filteredCards = cards.filter(card => {
          const category = card.getAttribute('data-category') || '';
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';

          const matchCat = currentCategory === 'all' || category.trim().toLowerCase() === currentCategory.trim().toLowerCase();
          const matchSearch = !currentSearch || title.includes(currentSearch) || desc.includes(currentSearch);
          return matchCat && matchSearch;
        });

        const totalItems = filteredCards.length;
        const { limit: itemsPerPage, label: viewLabel } = getItemsPerPage();
        const totalPages = Math.max(1, Math.ceil(totalItems / itemsPerPage));

        // Ajustar currentPage a rangos válidos
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;

        // 2. Mostrar únicamente las tarjetas del segmento actual
        cards.forEach(card => {
          const filterIdx = filteredCards.indexOf(card);
          if (filterIdx !== -1 && filterIdx >= startIndex && filterIdx < endIndex) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        // 3. Actualizar contadores y visibilidad
        if (visibleCount) visibleCount.textContent = String(totalItems);

        if (totalItems === 0) {
          if (noResults) noResults.classList.remove('hidden');
          if (paginationContainer) paginationContainer.classList.add('hidden');
        } else {
          if (noResults) noResults.classList.add('hidden');
          if (paginationContainer) paginationContainer.classList.remove('hidden');

          const actualFrom = startIndex + 1;
          const actualTo = Math.min(endIndex, totalItems);

          if (pFrom) pFrom.textContent = String(actualFrom);
          if (pTo) pTo.textContent = String(actualTo);
          if (pTotal) pTotal.textContent = String(totalItems);
          if (pIndicator) pIndicator.textContent = `Página ${currentPage} de ${totalPages}`;
          if (pViewMode) pViewMode.textContent = viewLabel;

          // 4. Renderizar botones de paginación
          renderPaginationControls(totalPages);
        }

        // 5. Desplazamiento suave al inicio de productos si el usuario navegó de página
        if (shouldScroll) {
          const section = document.getElementById('productos');
          if (section) {
            const rect = section.getBoundingClientRect();
            if (rect.top < -50 || rect.top > 250) {
              section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        }
      }

      function renderPaginationControls(totalPages) {
        if (!paginationNav || !paginationNumbers) return;

        // Actualizar estados Anterior / Siguiente
        if (btnPrev) {
          btnPrev.disabled = currentPage <= 1;
        }
        if (btnNext) {
          btnNext.disabled = currentPage >= totalPages;
        }

        paginationNumbers.innerHTML = '';

        // Generar ventana de páginas (Estilo Amazon / eBay)
        const pagesToDisplay = [];
        if (totalPages <= 5) {
          for (let i = 1; i <= totalPages; i++) pagesToDisplay.push(i);
        } else {
          if (currentPage <= 3) {
            pagesToDisplay.push(1, 2, 3, 4, '...', totalPages);
          } else if (currentPage >= totalPages - 2) {
            pagesToDisplay.push(1, '...', totalPages - 3, totalPages - 2, totalPages - 1, totalPages);
          } else {
            pagesToDisplay.push(1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages);
          }
        }

        pagesToDisplay.forEach(item => {
          if (item === '...') {
            const ellipsis = document.createElement('span');
            ellipsis.className = 'px-1.5 sm:px-2 text-xs font-bold text-slate-400 select-none';
            ellipsis.textContent = '…';
            paginationNumbers.appendChild(ellipsis);
          } else {
            const pageBtn = document.createElement('button');
            pageBtn.type = 'button';
            const isActive = item === currentPage;
            pageBtn.className = isActive
              ? 'min-h-10 min-w-10 px-3 py-2 text-xs font-black rounded-lg bg-brand-pink text-white shadow-sm border border-brand-pink'
              : 'min-h-10 min-w-10 px-3 py-2 text-xs font-bold rounded-lg border border-pink-200 bg-white text-slate-700 hover:bg-pink-50 hover:text-brand-pink hover:border-brand-pink/60 transition-all';
            pageBtn.textContent = String(item);
            pageBtn.setAttribute('aria-label', `Ir a página ${item}`);
            if (isActive) {
              pageBtn.setAttribute('aria-current', 'page');
            }
            pageBtn.addEventListener('click', () => {
              if (currentPage !== item) {
                currentPage = Number(item);
                updateGallery(true);
              }
            });
            paginationNumbers.appendChild(pageBtn);
          }
        });
      }

      // Event listeners para controles Anterior y Siguiente
      if (btnPrev) {
        btnPrev.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            updateGallery(true);
          }
        });
      }

      if (btnNext) {
        btnNext.addEventListener('click', () => {
          const { limit: itemsPerPage } = getItemsPerPage();
          const filteredCount = cards.filter(card => {
            const category = card.getAttribute('data-category') || '';
            const title = card.getAttribute('data-title') || '';
            const desc = card.getAttribute('data-desc') || '';
            const matchCat = currentCategory === 'all' || category.trim().toLowerCase() === currentCategory.trim().toLowerCase();
            const matchSearch = !currentSearch || title.includes(currentSearch) || desc.includes(currentSearch);
            return matchCat && matchSearch;
          }).length;
          const totalPages = Math.max(1, Math.ceil(filteredCount / itemsPerPage));

          if (currentPage < totalPages) {
            currentPage++;
            updateGallery(true);
          }
        });
      }

      // Listener de redimensión para adaptar límites responsivos dinámicamente
      let resizeTimer;
      function getBreakpointTier() {
        const w = window.innerWidth;
        if (w >= 1280) return 'xl';
        if (w >= 1024) return 'lg';
        if (w >= 640) return 'sm';
        return 'xs';
      }
      let previousBreakpointTier = getBreakpointTier();

      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          const currentTier = getBreakpointTier();
          if (currentTier !== previousBreakpointTier) {
            previousBreakpointTier = currentTier;
            updateGallery(false);
          }
        }, 120);
      });

      // Ordenamiento de tarjetas
      function sortCards(mode) {
        const sorted = cards.sort((a, b) => {
          const rawA = a.getAttribute('data-price');
          const rawB = b.getAttribute('data-price');
          const priceA = rawA !== null && rawA !== '' ? parseFloat(rawA) : NaN;
          const priceB = rawB !== null && rawB !== '' ? parseFloat(rawB) : NaN;
          const downA = parseInt(a.getAttribute('data-downloads') || '0');
          const downB = parseInt(b.getAttribute('data-downloads') || '0');

          if (mode === 'price-asc') {
            if (isNaN(priceA) && isNaN(priceB)) return 0;
            if (isNaN(priceA)) return 1;
            if (isNaN(priceB)) return -1;
            return priceA - priceB;
          }
          if (mode === 'price-desc') {
            if (isNaN(priceA) && isNaN(priceB)) return 0;
            if (isNaN(priceA)) return 1;
            if (isNaN(priceB)) return -1;
            return priceB - priceA;
          }
          if (mode === 'popular') return downB - downA;
          return 0; // Orden por defecto
        });

        sorted.forEach(card => grid.appendChild(card));
        updateGallery(false);
      }

      // Event listeners para filtros de categoría
      filterBtns.forEach(btn => {
        btn.addEventListener('click', function () {
          filterBtns.forEach(b => {
            b.classList.remove('bg-brand-pink', 'text-white', 'border-brand-pink');
            b.classList.add('bg-white', 'text-slate-700', 'border-pink-200/80');
          });
          this.classList.remove('bg-white', 'text-slate-700', 'border-pink-200/80');
          this.classList.add('bg-brand-pink', 'text-white', 'border-brand-pink');

          currentCategory = this.getAttribute('data-cat') || 'all';
          currentPage = 1; // Reiniciar a página 1 al cambiar categoría
          updateGallery(false);
        });
      });

      // Buscador en vivo
      if (searchInput) {
        searchInput.addEventListener('input', function (e) {
          currentSearch = e.target.value.trim().toLowerCase();
          currentPage = 1; // Reiniciar a página 1 al buscar
          updateGallery(false);
        });
      }

      // Dropdown de ordenamiento
      if (sortSelect) {
        sortSelect.addEventListener('change', function (e) {
          sortCards(e.target.value);
        });
      }

      // Inicializar galería y paginación al cargar
      updateGallery(false);

      // FAQ Accordion Toggle
      const faqToggles = document.querySelectorAll('.faq-toggle');
      faqToggles.forEach(toggle => {
        toggle.addEventListener('click', function () {
          const item = this.closest('.faq-item');
          if (!item) return;
          const answer = item.querySelector('.faq-answer');
          const isExpanded = this.getAttribute('aria-expanded') === 'true';

          // Close other open FAQs
          document.querySelectorAll('.faq-item').forEach(otherItem => {
            if (otherItem !== item) {
              otherItem.querySelector('.faq-answer')?.classList.remove('is-open');
              otherItem.querySelector('.faq-toggle')?.setAttribute('aria-expanded', 'false');
              const otherIcon = otherItem.querySelector('.faq-icon');
              if (otherIcon) {
                otherIcon.classList.remove('rotate-45');
              }
            }
          });

          if (isExpanded) {
            answer?.classList.remove('is-open');
            this.setAttribute('aria-expanded', 'false');
            const icon = this.querySelector('.faq-icon');
            if (icon) icon.classList.remove('rotate-45');
          } else {
            answer?.classList.add('is-open');
            this.setAttribute('aria-expanded', 'true');
            const icon = this.querySelector('.faq-icon');
            if (icon) icon.classList.add('rotate-45');
          }
        });
      });

      // Showcase Móvil de Joyería: Carrusel 100% automático (5s por imagen, sin controles manuales)
      const heroMainImg = document.getElementById('mobile-hero-main-img');
      const heroCaption = document.getElementById('mobile-hero-caption');
      const heroSubcaption = document.getElementById('mobile-hero-subcaption');
      const heroBadge = document.getElementById('mobile-hero-badge-tag');
      const heroDataEl = document.getElementById('mobile-hero-data');

      if (heroMainImg && heroDataEl) {
        try {
          const heroProducts = JSON.parse(heroDataEl.textContent || '[]');
          if (Array.isArray(heroProducts) && heroProducts.length > 1) {
            let heroIndex = 0;
            setInterval(() => {
              heroIndex = (heroIndex + 1) % heroProducts.length;
              const nextItem = heroProducts[heroIndex];

              // Transición suave de opacidad (fade) sincronizada
              heroMainImg.style.opacity = '0.25';
              if (heroCaption) heroCaption.style.opacity = '0.3';
              if (heroSubcaption) heroSubcaption.style.opacity = '0.3';

              setTimeout(() => {
                if (nextItem.image) {
                  heroMainImg.src = nextItem.image;
                  heroMainImg.alt = nextItem.title || 'Pieza de joyería Bunu Shop';
                }
                if (heroCaption && nextItem.title) {
                  heroCaption.textContent = nextItem.title;
                }
                if (heroSubcaption && nextItem.subtitle) {
                  heroSubcaption.textContent = nextItem.subtitle;
                }
                if (heroBadge && nextItem.badge) {
                  heroBadge.textContent = nextItem.badge;
                }

                heroMainImg.style.opacity = '1';
                if (heroCaption) heroCaption.style.opacity = '1';
                if (heroSubcaption) heroSubcaption.style.opacity = '1';
              }, 250);
            }, 5000);
          }
        } catch (e) {
          console.error('Error inicializando carrusel móvil:', e);
        }
      }

      // Product Image Lightbox (Galería de productos)
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxCaption = document.getElementById('lightbox-caption');
      const lightboxClose = document.getElementById('lightbox-close');
      const lightboxProjectsGrid = document.getElementById('projects-grid');
      let lightboxTriggerEl = null;

      function handleLightboxKeydown(e) {
        if (e.key === 'Escape') {
          closeLightbox();
          return;
        }
        if (e.key === 'Tab') {
          // Único elemento focuseable dentro del overlay: el botón de cierre.
          e.preventDefault();
          lightboxClose?.focus();
        }
      }

      function openLightbox(trigger) {
        if (!lightbox || !lightboxImg) return;
        const fullSrc = trigger.getAttribute('data-full');
        const altText = trigger.getAttribute('data-alt') || '';
        if (!fullSrc) return;

        lightboxTriggerEl = trigger;
        lightboxImg.src = fullSrc;
        lightboxImg.alt = altText;
        if (lightboxCaption) lightboxCaption.textContent = altText;

        lightbox.classList.remove('hidden');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.classList.add('overflow-hidden');

        // Forzar reflow para que la transición de entrada se dispare (mantener en sync con los 250ms de global.css)
        void lightbox.offsetWidth;
        lightbox.classList.add('is-open');

        if (lightboxClose) lightboxClose.focus();
        document.addEventListener('keydown', handleLightboxKeydown);
      }

      function closeLightbox() {
        if (!lightbox) return;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('overflow-hidden');
        document.removeEventListener('keydown', handleLightboxKeydown);

        // Mantener sincronizado con la duración de transición de .lightbox-overlay en global.css (250ms)
        if (prefersReducedMotion) {
          lightbox.classList.add('hidden');
        } else {
          setTimeout(() => lightbox.classList.add('hidden'), 250);
        }

        if (lightboxTriggerEl) {
          lightboxTriggerEl.focus();
          lightboxTriggerEl = null;
        }
      }

      if (lightboxProjectsGrid && lightbox) {
        lightboxProjectsGrid.addEventListener('click', function (e) {
          const trigger = e.target.closest('.lightbox-trigger');
          if (trigger) openLightbox(trigger);
        });
      }

      if (lightboxClose) {
        lightboxClose.addEventListener('click', closeLightbox);
      }

      if (lightbox) {
        lightbox.addEventListener('click', function (e) {
          if (e.target === lightbox) closeLightbox();
        });
      }
    });
  </script>
  <!-- END: Interactive Client-Side Scripts -->

</body>
</html>
