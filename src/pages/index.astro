        </div>
        
        <!-- Right Side: Imagery and Social Floating Icons -->
        <div class="lg:col-span-6 relative min-h-[420px] lg:min-h-full bg-pink-50">
          <img 
            alt={`${siteInfo.name} - ${siteInfo.role}`} 
            class="w-full h-full object-cover object-center filter brightness-[0.98]" 
