---
import { getPortfolioData } from '../lib/storage';
import Analytics from '../components/Analytics.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import '../styles/global.css';
import { 
  Sparkles, 
  Heart, 
  Plane, 
  ShieldCheck, 
  Camera, 
  Crown, 
  Image as LucideImage, 
  Star, 
  MapPin, 
  Search, 
  Plus, 
  Settings, 
  Mail, 
  Instagram, 
  Facebook, 
  ArrowRight, 
  Check, 
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  Gem,
  X
} from 'lucide-astro';

export const prerender = false;

const data = await getPortfolioData();
const siteInfo = data?.siteInfo || {};
const metrics = data?.metrics || {};
const featuredProduct = data?.featuredProduct || {};
const services = data?.services || [];
const workflowPhases = data?.workflowPhases || [];
const projects = data?.projects || [];
const blogPosts = data?.blogPosts || [];

// Solo mostramos en el frontend público los proyectos y posts que no estén marcados como borrador
const publishedProjects = (projects || []).filter((p: any) => p && p.status !== 'draft');
const publishedPosts = (blogPosts || []).filter((p: any) => p && p.status !== 'draft');
const featuredPost = publishedPosts.find((p: any) => p && p.isFeatured) || publishedPosts[0];
const recentPosts = publishedPosts.filter((p: any) => p && p.id !== featuredPost?.id);

// Productos destacados para el showcase visual en la vista móvil
const mobileHeroProducts = [
  {
    image: siteInfo.heroImage || '/images/bunu/IMG_1451.webp',
    title: 'Dúo de Luz - Balines con Baño de Oro',
    subtitle: 'Tejido artesanal ajustable',
    badge: '100% Hecho a Mano'
  },
  ...(publishedProjects || []).slice(0, 3).map((p: any) => ({
    image: p.image,
    title: p.title,
    subtitle: p.category || 'Accesorio Personalizado',
    badge: p.tags?.[0] || 'Diseño Exclusivo'
  }))
];

// Categorías dinámicas para los filtros
const projectCategories = ['Todos', ...Array.from(new Set(publishedProjects.map((p: any) => p?.category).filter(Boolean)))];

const faqs = (data as any).faqs || [];
const testimonials = (data as any).testimonials || [];

// Structured Data (JSON-LD) para SEO, GEO y AEO.
// El dominio canónico va fijo: si se derivara de Astro.url.origin, el deploy
// espejo bunu-shop.vercel.app se colaba dentro de cada @id, url, logo e image
// del grafo y en og:url. El <link rel="canonical"> ya estaba fijo; el schema no.
const siteUrl = "https://bunushop.store";

// La dueña lleva dos apellidos y la buscan por el primero (Sorelly) o por el
// segundo (Eljach); "Selly" es la variante mal escrita más habitual. Usamos el
// nombre completo salvo que el CMS ya traiga uno con dos o más apellidos.
const ownerFullName = (siteInfo.owner && siteInfo.owner.trim().split(/\s+/).length >= 3)
  ? siteInfo.owner.trim()
  : "Mary Sorelly Eljach";

const schemaPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#founder`,
  "name": ownerFullName,
  "alternateName": [
    "Mary Sorelly",
    "Mary Eljach",
    "Mary Selly",
    "Mary Sorely",
    "Mary Soreli",
    "Mary Sorelly Eljach",
    "Mary Eljach Sorelly",
    "Mary de Bunu Shop",
    "Mary Sorelly BunuShop",
    "BunuShop Mary Sorelly",
    "Bunu Shop Mary Eljach",
    "Bunu Shop by Mary Eljach",
    "Bunu Shop Mary Selly",
    "Mary Sorelly Accesorios"
  ],
  "jobTitle": "Fundadora, Diseñadora y Artesana",
  "worksFor": {
    "@id": `${siteUrl}/#store`
  },
  "image": `${siteUrl}/images/bunu/Perfil.webp`,
  "url": `${siteUrl}/#about`,
  "description": "Mary Sorelly Eljach es la creadora y artesana colombiana fundadora de Bunu Shop (BunuShop), especializada en diseño y elaboración artesanal de accesorios hechos a mano, tejido en mostacilla checa calibrada, pulseras en macramé y piezas personalizadas en Colombia.",
  "nationality": {
    "@type": "Country",
    "name": "Colombia"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Gamarra",
    "addressRegion": "Cesar",
    "addressCountry": "CO"
  },
  "knowsAbout": [
    "Joyería artesanal",
    "Accesorios hechos a mano",
    "Mostacilla checa calibrada",
    "Tejido Miyuki",
    "Pulseras personalizadas",
    "Macramé",
    "Artesanías de Colombia"
  ],
  "sameAs": [
    siteInfo.socialLinks?.instagram || "https://www.instagram.com/bunu_shop15/",
    siteInfo.socialLinks?.facebook || "https://www.facebook.com/profile.php?id=100028253305796",
    siteInfo.socialLinks?.whatsapp || "https://wa.me/573160771180"
  ]
};

const schemaJewelryStore = {
  "@context": "https://schema.org",
  "@type": "JewelryStore",
  "@id": `${siteUrl}/#store`,
  "name": "Accesorios Bunu Shop",
  "alternateName": [
    "Bunu Shop",
    "BunuShop",
    "Bunu Shop by Mary Eljach",
    "Bunu Shop Mary Eljach",
    "Bunu Shop Mary Sorelly",
    "Bunu Shop Mary Selly",
    "BunuShop Mary Sorelly",
    "Mary Sorelly BunuShop",
    "Accesorios Bunu Shop Colombia",
    "Bunu Shop por Mary Sorelly Eljach"
  ],
  "url": siteUrl,
  "logo": `${siteUrl}/images/bunu/logo.jpg`,
  "image": `${siteUrl}/images/bunu/logo.jpg`,
  "description": "Tienda de joyería artesanal y accesorios personalizados hechos a mano en Colombia por Mary Sorelly Eljach: pulseras en macramé, dijes en mostacilla checa calibrada, cadenas con baño de oro y piezas exclusivas con envíos a todo el país.",
  "telephone": siteInfo.contactPhone || "+57 316 077 1180",
  "email": siteInfo.contactEmail || "accesoriosbunushop@gmail.com",
  "priceRange": "$$",
  "currenciesAccepted": "COP",
  "paymentAccepted": "Nequi, Daviplata, Bancolombia, Transferencia bancaria",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Gamarra",
    "addressRegion": "Cesar",
    "addressCountry": "CO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 8.3228,
    "longitude": -73.7431
  },
  // El copy del sitio ya anuncia "ENVÍOS SEGUROS COLOMBIA E INTERNACIONAL",
  // pero el schema solo declaraba Colombia y contradecía a la página.
  "areaServed": [
    { "@type": "Country", "name": "Colombia" },
    { "@type": "Country", "name": "República Dominicana" },
    { "@type": "Place", "name": "América Latina" },
    { "@type": "City", "name": "Bogotá" },
    { "@type": "City", "name": "Medellín" },
    { "@type": "City", "name": "Bucaramanga" },
    { "@type": "City", "name": "Valledupar" },
    { "@type": "City", "name": "Santa Marta" }
  ],
  "founder": {
    "@id": `${siteUrl}/#founder`
  },
  "sameAs": [
    siteInfo.socialLinks?.instagram || "https://www.instagram.com/bunu_shop15/",
    siteInfo.socialLinks?.facebook || "https://www.facebook.com/profile.php?id=100028253305796",
    siteInfo.socialLinks?.whatsapp || "https://wa.me/573160771180"
  ]
};

// Un FAQPage sin preguntas es markup inválido a ojos de Google, así que solo
// emitimos el bloque cuando hay contenido real que declarar. Mismo criterio
// para el HowTo respecto a sus pasos.
const schemaFaq = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f: any) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

const schemaHowTo = workflowPhases.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Cómo pedir tu accesorio personalizado en Bunu Shop",
  "description": "Proceso paso a paso para ordenar accesorios hechos a mano y personalizados con visto bueno previo y envío garantizado en Colombia.",
  "totalTime": "P3D",
  "step": workflowPhases.map((w: any, idx: number) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "name": w.title,
    "text": w.description
  }))
} : null;
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="es">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>

  <!-- Google Tag Manager -->
  <GoogleTagManager />
  <!-- End Google Tag Manager -->

  <!-- Primary SEO Meta Tags -->
  <!-- 55 caracteres: por encima de ~60 Google trunca y se perdía "en Colombia".
       La variante "BunuShop" en una palabra queda cubierta por alternateName
       del schema y por el bloque semántico de marca. -->
  <title>Bunu Shop | Joyería Artesanal de Mary Sorelly, Colombia</title>
  <meta name="title" content="Bunu Shop | Joyería Artesanal de Mary Sorelly, Colombia"/>
  <meta name="description" content="Bunu Shop (BunuShop) de Mary Sorelly Eljach: joyería artesanal y accesorios hechos a mano en Colombia. Pulseras en mostacilla checa calibrada, macramé y baño de oro con envíos a toda Colombia."/>
  <meta name="keywords" content="Mary Sorelly, Mary Eljach, Mary Selly, Mary Sorelly Eljach, Mary Sorely, Mary Soreli, BunuShop, Bunu Shop, Bunu Shop Mary Eljach, Bunu Shop by Mary Eljach, BunuShop Mary Sorelly, Mary Sorelly Bunu Shop, joyería artesanal Colombia, accesorios hechos a mano Colombia, pulseras personalizadas Colombia, mostacilla checa calibrada Colombia, tejido miyuki Colombia, pulseras en macramé, pulseras de protección, pulseras San Benito Colombia, pulseras Virgen del Carmen, pulseras de pareja, accesorios Gamarra Cesar"/>
  <meta name="author" content="Mary Sorelly Eljach"/>
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"/>
  <link rel="canonical" href="https://bunushop.store/"/>
  
  <!-- Favicon & Icons for Browser Tabs & Google Search Snippets -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico"/>
  <link rel="shortcut icon" href="/favicon.ico"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png"/>
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png"/>
  <link rel="icon" type="image/png" sizes="144x144" href="/favicon-144x144.png"/>
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png"/>
  <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
  <link rel="manifest" href="/site.webmanifest"/>
  <meta name="theme-color" content="#ec4899"/>

  <!-- Geo Tags (Local SEO & GEO) -->
  <meta name="geo.region" content="CO-CES"/>
  <meta name="geo.placename" content="Gamarra, Cesar, Colombia"/>
  
  <!-- Open Graph / Facebook / WhatsApp Link Previews -->
  <meta property="og:type" content="website"/>
  <meta property="og:locale" content="es_CO"/>
  <meta property="og:url" content={siteUrl}/>
  <meta property="og:site_name" content="Bunu Shop (BunuShop) - Mary Sorelly Eljach"/>
  <meta property="og:title" content="Bunu Shop (BunuShop) | Joyería Hecha a Mano por Mary Sorelly Eljach"/>
  <meta property="og:description" content="Joyería artesanal y accesorios personalizados hechos a mano en Colombia por Mary Sorelly Eljach. Pulseras en mostacilla checa y baño de oro con envíos a todo el país."/>
  <meta property="og:image" content={`${siteUrl}/images/bunu/logo.jpg`}/>
  <meta property="og:image:secure_url" content={`${siteUrl}/images/bunu/logo.jpg`}/>
  <meta property="og:image:type" content="image/jpeg"/>
  <meta property="og:image:width" content="1080"/>
  <meta property="og:image:height" content="1080"/>
  <meta property="og:image:alt" content="Bunu Shop por Mary Sorelly Eljach - Joyería Artesanal en Colombia"/>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:url" content={siteUrl}/>
  <meta name="twitter:title" content="Bunu Shop (BunuShop) | Joyería Hecha a Mano por Mary Sorelly Eljach"/>
  <meta name="twitter:description" content="Joyería artesanal y accesorios personalizados hechos a mano en Colombia por Mary Sorelly Eljach. Pulseras en mostacilla checa y baño de oro con envíos a todo el país."/>
  <meta name="twitter:image" content={`${siteUrl}/images/bunu/logo.jpg`}/>

  <!-- Structured Data JSON-LD (SEO, GEO & AEO) -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaPerson)}/>
  <script type="application/ld+json" set:html={JSON.stringify(schemaJewelryStore)}/>
  {schemaFaq && <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)}/>}
  {schemaHowTo && <script type="application/ld+json" set:html={JSON.stringify(schemaHowTo)}/>}

  <Analytics />
  
  <!-- Preload Hero Image for LCP Optimization -->
  <link rel="preload" as="image" href="/images/bunu/IMG_1451.webp" type="image/webp" fetchpriority="high"/>

  <!-- Google Fonts: Non-render-blocking font loading -->
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap"/>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'"/>
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet"/>
  </noscript>
  
  
  <style>
    /* Sutiles líneas diagonales de acento en tono rosa/fucsia de la marca */
    .decor-line-diagonal {
      position: relative;
    }
    .decor-line-diagonal::before {
      content: '';
      position: absolute;
      width: 45px;
      height: 2px;
      background-color: #ec4899;
      transform: rotate(-35deg);
      top: -14px;
      left: 0;
    }
    .decor-line-diagonal-right {
      position: relative;
    }
    .decor-line-diagonal-right::after {
      content: '';
      position: absolute;
      width: 50px;
      height: 2px;
      background-color: #ec4899;
      transform: rotate(-30deg);
      top: -12px;
      right: 0;
    }
    .custom-shadow {
      box-shadow: 0 20px 40px -15px rgba(236, 72, 153, 0.08);
    }
  </style>
</head>
<body class="bg-white text-slate-800 font-sans antialiased selection:bg-brand-pink selection:text-white">
  <!-- Google Tag Manager (noscript) -->
  <GoogleTagManager placement="body" />
  <!-- End Google Tag Manager (noscript) -->

  <noscript>
    <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
  </noscript>

  <!-- BEGIN: Navigation -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-pink-100/60 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
      <!-- Brand Logo -->
      <a class="flex items-center space-x-3 group" href="#hero">
        <img 
          src={siteInfo.logoImage || "/images/bunu/logo-nav.webp"} 
          alt="Bunu Shop Logo" 
          width="48"
          height="48"
          class="h-12 w-12 rounded-full object-cover shadow-sm border border-brand-pink/30 group-hover:scale-105 transition-transform"
        />
        <div class="flex flex-col">
          <span class="text-xl font-black font-display tracking-tight text-slate-900 group-hover:text-brand-pink transition-colors leading-none">Bunu Shop</span>
          <span class="text-[10px] tracking-widest uppercase font-semibold text-pink-700 mt-1">Accesorios &amp; Joyería</span>
        </div>
      </a>
      
      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-6 text-xs font-bold tracking-wider uppercase">
        <a class="text-brand-pink transition-colors" href="#hero">Inicio</a>
        <a class="text-slate-600 hover:text-brand-pink transition-colors" href="#galeria">Catálogo</a>
        <a class="text-slate-600 hover:text-brand-pink transition-colors" href="#proceso">Cómo Comprar</a>
        <a class="text-slate-600 hover:text-brand-pink transition-colors" href="#faq">Preguntas</a>
        <a class="text-slate-600 hover:text-brand-pink transition-colors" href="#about">Sobre Mí</a>
        {services && services.length > 0 && (
          <a class="text-slate-600 hover:text-brand-pink transition-colors" href="#servicios">Servicios</a>
        )}
        <a class="text-slate-600 hover:text-brand-pink transition-colors" href="#blog">Blog &amp; Tips</a>
      </nav>
      
      <!-- Action & Mobile Toggle -->
      <div class="flex items-center space-x-3">
        <a 
          class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 text-xs uppercase font-bold tracking-wider text-white bg-brand-pink hover:bg-brand-pinkHover rounded-md transition-all shadow-md shadow-brand-pink/25 gap-2" 
          href={siteInfo.socialLinks?.whatsapp ? `${siteInfo.socialLinks.whatsapp}?text=Hola%20Bunu%20Shop,%20deseo%20hacer%20un%20pedido` : "https://wa.me/573160771180?text=Hola%20Bunu%20Shop,%20deseo%20hacer%20un%20pedido"} 
          target="_blank"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>Pedir Ahora</span>
        </a>
        <button aria-label="Abrir menú de navegación" class="lg:hidden min-h-11 min-w-11 flex items-center justify-center rounded-md bg-brand-pink text-white hover:bg-brand-pinkHover transition-colors focus:outline-none" id="menu-toggle">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Collapsible Mobile Menu -->
    <div class="hidden lg:hidden bg-white border-b border-pink-100 px-6 py-4 space-y-3" id="mobile-menu">
      <a class="block text-brand-pink font-bold py-1 text-sm uppercase" href="#hero">Inicio</a>
      <a class="block text-slate-700 hover:text-brand-pink font-semibold py-1 text-sm uppercase" href="#galeria">Catálogo</a>
      <a class="block text-slate-700 hover:text-brand-pink font-semibold py-1 text-sm uppercase" href="#proceso">Cómo Comprar</a>
      <a class="block text-slate-700 hover:text-brand-pink font-semibold py-1 text-sm uppercase" href="#faq">Preguntas Frecuentes</a>
      <a class="block text-slate-700 hover:text-brand-pink font-semibold py-1 text-sm uppercase" href="#about">Sobre Mí</a>
      {services && services.length > 0 && (
        <a class="block text-slate-700 hover:text-brand-pink font-semibold py-1 text-sm uppercase" href="#servicios">Servicios</a>
      )}
      <a class="block text-slate-700 hover:text-brand-pink font-semibold py-1 text-sm uppercase" href="#blog">Blog &amp; Tips</a>
      <a class="block text-brand-pink font-bold pt-2 uppercase text-xs" href={siteInfo.socialLinks?.whatsapp ? `${siteInfo.socialLinks.whatsapp}?text=Hola%20Bunu%20Shop,%20deseo%20hacer%20un%20pedido` : "https://wa.me/573160771180"} target="_blank">Contactar por WhatsApp →</a>
    </div>
  </header>
  <!-- END: Navigation -->

  <!-- BEGIN: Main Landmark Content -->
  <main id="main-content">

  <!-- BEGIN: Semantic Invisible SEO / Entity Information -->
  <section class="sr-only" aria-label="Información de marca y creadora">
    <h2>Bunu Shop (BunuShop) - Joyería Artesanal en Colombia por Mary Sorelly</h2>
    <p>
      Bunu Shop (también conocida como BunuShop) es una marca colombiana de joyería y accesorios artesanales hechos a mano fundada por la artesana Mary Sorelly (Mary Sorely, Mary Soreli). Especializada en pulseras en macramé, dijes en mostacilla checa calibrada, tejido tipo Miyuki, accesorios con baño de oro y piezas religiosas de protección con envíos a Bogotá, Bucaramanga, Valledupar, Santa Marta y todo el territorio colombiano.
    </p>
  </section>
  <!-- END: Semantic Invisible SEO / Entity Information -->

  <!-- BEGIN: Hero Section -->
  <section class="relative overflow-hidden bg-white" id="hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-10">
      <!-- ============================================================ -->
      <!-- VISTA MÓVIL HERO (< 1024px)                                   -->
      <!-- Rediseño enfocado en captar interés visual inmediato con fotos -->
      <!-- ============================================================ -->
      <div class="block lg:hidden">
        <div class="bg-brand-darkNavy rounded-3xl p-4 sm:p-6 shadow-2xl relative overflow-hidden border border-pink-900/40 text-white">
          <!-- Brillos decorativos de fondo -->
          <div class="absolute -top-16 -right-16 w-52 h-52 bg-brand-pink/20 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-16 -left-16 w-52 h-52 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>

