---
/**
 * Capa de eventos personalizados para el dataLayer.
 *
 * GA4 se carga y configura desde Google Tag Manager (contenedor GTM-NDFHFFTN),
 * NO aquí. Este componente ya no inyecta gtag.js; solo empuja al dataLayer el
 * evento que en esta tienda es la conversión real: el clic a WhatsApp (no hay
 * carrito ni pago en el sitio). En GTM se recoge con un activador de evento
 * personalizado "whatsapp_click" y se reenvía a GA4.
 *
 * El listener es barato y no depende de ninguna variable de entorno, así que
 * se ejecuta siempre; si GTM no estuviera, los push solo se acumulan sin
 * efecto.
 */
---

<script is:inline>
  window.dataLayer = window.dataLayer || [];

  // Separamos la intención (pedir / consultar / contacto) para distinguir en
  // GA4 a quien quiere comprar de quien solo pregunta. La etiqueta sale del
  // aria-label que ya tienen los enlaces del catálogo, así no hay que tocar
  // botón por botón.
  document.addEventListener('click', function (evento) {
    var enlace = evento.target && evento.target.closest
      ? evento.target.closest('a[href*="wa.me"]')
      : null;
    if (!enlace) return;

    var etiqueta = (enlace.getAttribute('aria-label') || enlace.textContent || '').trim();
    var intencion = 'contacto';
    var producto = '';

    if (/^pedir\s+/i.test(etiqueta)) {
      intencion = 'pedir';
      producto = etiqueta.replace(/^pedir\s+/i, '');
    } else if (/^consultar sobre\s+/i.test(etiqueta)) {
      intencion = 'consultar';
      producto = etiqueta.replace(/^consultar sobre\s+/i, '');
    }

    var seccion = enlace.closest('section');
    window.dataLayer.push({
      event: 'whatsapp_click',
      intencion: intencion,
      producto: producto || '(sin producto)',
      seccion: (seccion && seccion.id) || '(sin seccion)',
      pagina: window.location.pathname,
    });
  });
</script>
